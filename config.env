# ============================================================
# werss-app 全局配置 —— 全部脚本唯一配置来源，换机器只需改这里
# 注：所有值支持环境变量临时覆盖（${VAR:-默认} 语法），便于演练/调试
# ============================================================

# ---- 服务 ----
# 应用端口（本机 8001，与其他应用冲突时才需要改）
WERSS_PORT=${WERSS_PORT:-8001}
WERSS_APP_URL=${WERSS_APP_URL:-http://localhost:8001}
# 容器名（保活/状态查询/数据导入都用它）
WERSS_CONTAINER=${WERSS_CONTAINER:-we-mp-rss}
# 镜像：@digest 锁定与原系统完全相同的构建（9d1190991a86, arm64），避免上游更新引入差异
WERSS_IMAGE=${WERSS_IMAGE:-rachelos/we-mp-rss@sha256:7873205d40610ef894a419ab2691d1039cf3f0e442fee11a13df4aa3997c53d1}

# ---- we-mp-rss 管理端登录（浏览器自动化自动登录用，即应用初始默认账号）----
WERSS_ADMIN_USER=${WERSS_ADMIN_USER:-admin}
WERSS_ADMIN_PASS=${WERSS_ADMIN_PASS:-admin@123}

# ---- 采集节奏（防风控。默认与原系统完全一致，不建议调快）----
# 单次 worker 预算秒数
WERSS_CHUNK_BUDGET=${WERSS_CHUNK_BUDGET:-300}
# 公司间隔上下限（秒）
WERSS_GAP_MIN=${WERSS_GAP_MIN:-45}
WERSS_GAP_MAX=${WERSS_GAP_MAX:-90}
# 每处理几家公司随机休息一次（下限/上限家数）
WERSS_REST_EVERY_MIN=${WERSS_REST_EVERY_MIN:-3}
WERSS_REST_EVERY_MAX=${WERSS_REST_EVERY_MAX:-5}
# 休息时长上下限（秒）
WERSS_REST_MIN=${WERSS_REST_MIN:-120}
WERSS_REST_MAX=${WERSS_REST_MAX:-300}
# 连续多少个"未找到"触发金丝雀风控探测
WERSS_CANARY_THRESHOLD=${WERSS_CANARY_THRESHOLD:-5}
