# ============================================================
# werss-app 全局配置 —— 全部脚本唯一配置来源，换机器只需改这里
# ============================================================

# ---- 服务 ----
# 应用端口（本机 8001，与其他应用冲突时才需要改）
WERSS_PORT=8001
WERSS_APP_URL=http://localhost:8001
# 容器名（保活/状态查询/数据导入都用它）
WERSS_CONTAINER=we-mp-rss
# 镜像：@digest 锁定与原系统完全相同的构建，避免上游更新引入差异
WERSS_IMAGE=rachelos/we-mp-rss:latest

# ---- we-mp-rss 管理端登录（浏览器自动化自动登录用，即应用初始默认账号）----
WERSS_ADMIN_USER=admin
WERSS_ADMIN_PASS=admin@123

# ---- 采集节奏（防风控。默认与原系统完全一致，不建议调快）----
# 单次 worker 预算秒数
WERSS_CHUNK_BUDGET=300
# 公司间隔上下限（秒）
WERSS_GAP_MIN=45
WERSS_GAP_MAX=90
# 每处理几家公司随机休息一次（下限/上限家数）
WERSS_REST_EVERY_MIN=3
WERSS_REST_EVERY_MAX=5
# 休息时长上下限（秒）
WERSS_REST_MIN=120
WERSS_REST_MAX=300
# 连续多少个"未找到"触发金丝雀风控探测
WERSS_CANARY_THRESHOLD=5
